# LLM API Manager 环境变量示例
#
# 用法：cp .env.example .env
# 服务会依次查找 server/.env（进程 cwd）与仓库根目录的 .env，前者优先。
# 进程环境变量优先级最高：已经存在的同名变量不会被 .env 覆盖。

# 监听地址。对外暴露请放在 HTTPS 反向代理之后。
HOST=127.0.0.1
PORT=8787

# 写进 Agent 配置的网关地址（不带 /v1）。
# 反向代理或容器部署时必须显式设置为客户端能访问到的地址；
# 留空时按 HOST:PORT 推导（HOST 为 0.0.0.0 时回落为 127.0.0.1）。
# PUBLIC_BASE_URL=https://llm.example.com

# 数据目录。相对路径按进程 cwd 解析；npm workspaces 脚本的 cwd 是 server/，
# 因此默认落在 server/data。若想固定到仓库根目录，可设为 ../data。
# DATA_DIR=data

# 初始管理员账号，仅在首次创建账号时使用。
ADMIN_USERNAME=admin
# 应急通道：不设置时，首次启动不创建账号，而是在控制台打印一次性初始化令牌，
# 由你在网页设置页自己设置用户名与口令。
# 设置了 ADMIN_PASSWORD 则跳过网页初始化、直接用该口令建号（适合 Docker/systemd 等无交互部署）。
# ADMIN_PASSWORD=change-me

# 会话签名密钥。不设置时自动生成并保存到 data/instance.json，
# 删除该文件会让所有已登录会话失效。
# SESSION_SECRET=

# 供应商 API Key 与网关令牌的落盘加密密钥（任意长随机字符串）。
# 不设置时以明文保存，启动日志与 /api/health 会持续告警。
# DATA_ENCRYPTION_KEY=

# 日志级别：debug / info / warn / error
LOG_LEVEL=info

# 运行日志目录。默认是仓库根的 log/（不是 DATA_DIR，迁移数据目录时不会带走日志）。
# 设为 off 关闭落盘，只保留控制台输出。
# LOG_DIR=log

# 单个日志文件的滚动阈值（字节）与保留的历史文件个数。
# 超过阈值时 app.log → app.1.log → app.2.log …，最老的被删除。
# LOG_MAX_BYTES=5242880
# LOG_MAX_FILES=5

# Agent 配置根目录（其下是 .codex / .claude）。默认取当前 OS 用户家目录。
# 多租户或测试时可覆盖。
# AGENT_HOME_DIR=/home/you
