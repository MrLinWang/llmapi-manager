# ── 参考实现（同级克隆，不纳入本仓库）─────────────────────────────
/ref/

# ── 依赖 ────────────────────────────────────────────────────────────
node_modules/
.npm/
.pnp
.pnp.*

# ── 构建产物与缓存 ──────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
.vite/
.cache/

# ── 测试与覆盖率 ────────────────────────────────────────────────────
coverage/
.nyc_output/
test-results/
playwright-report/

# ── 日志与临时文件 ──────────────────────────────────────────────────
*.log
logs/
# 运行日志目录（server/src/config.ts 的 LOG_DIR 默认值）
/log/
/server/log/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.pid
*.pid.lock
*.tmp
*.swp
*~
tmp/
.tmp/
# 本地审查/验证用的临时目录（.probe 放一次性脚本，.final 放改动备份）
.probe/
.final/
# 待用户手工应用的系统配置副本（含令牌、内网地址，绝不入库）
.cleanup/
.eslintcache
.stylelintcache

# ── 凭据文件（防御性：这些都不应进入版本库）────────────────────────
*.pem
*.key
*.p12
*.pfx
id_rsa
id_ed25519
.ssh/
.npmrc
cookies.txt
*.har
# 调试时 curl -c/-b 生成的 cookie jar 常被随手命名成这些裸名
.c
.ck
cookies.json
cookie*.jar
session.json
# 手工备份/补丁残留
*.bak
*.orig
*.rej

# ── 环境变量（保留模板）─────────────────────────────────────────────
.env
.env.*
!.env.example
*.local

# ── 运行时数据 ──────────────────────────────────────────────────────
# 默认 DATA_DIR=data；npm workspaces 脚本的 cwd 是 server/，实际落在 server/data。
# 也可通过 DATA_DIR 指向别处，请自行确认不要提交。
/data/
/server/data/
/server/identity.json
/server/instance.json
/server/tenants/
# 损坏数据被隔离后的文件名形如 providers.json.corrupt-<时间戳>
*.corrupt-*

# ── 编辑器与操作系统 ────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
.idea/
.vscode/
.cxtest
.wt
*.bak-*

# ── Rust 工具链与构建（native/ 下的 N-API 模块）───────────────────────
# 本地安装的 Rust 工具链（家目录只读时临时装到仓库内，绝不能提交）
/.rust-toolchain/
# cargo 的构建产物与缓存；原生模块的 .node 二进制由构建生成
/native/*/target/
/native/*/.cargo/
# 编译出的原生二进制（各平台各自构建，不入库）
/native/*/*.node
# Cargo.lock 对二进制 crate 应当提交（锁定依赖版本），所以不忽略它

# ── Tauri 桌面构建产物与 sidecar stage ──────────────────────────────
/src-tauri/target/
/src-tauri/gen/
/src-tauri/runtime/

# 本地构建缓存（Tauri CLI/PowerShell 解析器）
/.npm-cache/
/.tmp-pwsh/
